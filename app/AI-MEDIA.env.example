# Chaves usadas apenas pelo servidor/local do LOGOS MASTER X.
# Nunca cole estes valores em JavaScript, HTML ou no navegador.
GEMINI_API_KEY=
OPENAI_API_KEY=
PEXELS_API_KEY=

# Modelos opcionais; se vazios, entram os padrões atuais do módulo.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VIDEO_MODEL=sora-2

# O primeiro provedor configurado é tentado no modo automático.
LOGOS_MEDIA_PROVIDER_ORDER=gemini,openai

# Opcional: mapa Mapbox 3D dentro do Atlas/Mídia X.
# Use apenas token público pk.* com restrição de domínio no painel Mapbox.
MAPBOX_PUBLIC_TOKEN=
