      },
      "intensity": 26
    },
    {
      "id": 44,
      "start": 171.20401,
      "end": 176.84401,
      "text": "Deus, restaura-nos, ó Senhor, a Ti, para que voltemos a ser como Dantes.",
      "kind": "development",
      "classification_scores": {
