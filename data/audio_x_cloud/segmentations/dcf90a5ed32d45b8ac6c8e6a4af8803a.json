        "text": 0,
        "context": 0,
        "development": 3,
        "application": 1,
        "climax": 0,
        "appeal": 0
      },
      "intensity": 27
    },
    {
      "id": 45,
      "start": 177.34401,
      "end": 181.904,
      "text": "E este versículo me fez uma curiosidade muito grande ao coração,",
      "kind": "application",
      "classification_scores": {
        "intro": 0,
        "text": 3,
        "context": 0,
        "development": 3,
        "application": 4,
        "climax": 3,
        "appeal": 0
      },
      "intensity": 27
    },
    {
      "id": 46,
      "start": 182.364,
      "end": 188.564,
      "text": "e fui estudá-lo, fui analisá-lo, e descobri coisas tão lindas a respeito do livro das Lamentações,",
      "kind": "development",
      "classification_scores": {
        "intro": 0,
        "text": 0,
        "context": 0,
        "development": 3,
        "application": 1,
        "climax": 3,
        "appeal": 0
      },
      "intensity": 27
    },
    {
      "id": 47,
      "start": 188.864,
      "end": 191.98401,
      "text": "e quero aqui hoje compartilhar com todos os irmãos.",
      "kind": "application",
      "classification_scores": {
        "intro": 0,
        "text": 0,
        "context": 0,
        "development": 3,
        "application": 4,
        "climax": 3,
        "appeal": 0
      },
      "intensity": 27
    },
    {
      "id": 48,
      "start": 192.404,
      "end": 197.104,
      "text": "Quando eu abro a minha Bíblia aqui, e leio primeiramente o nome de Lamentações,",
      "kind": "development",
      "classification_scores": {
        "intro": 0,
        "text": 0,
        "context": 0,
        "development": 3,
        "application": 1,
        "climax": 3,
