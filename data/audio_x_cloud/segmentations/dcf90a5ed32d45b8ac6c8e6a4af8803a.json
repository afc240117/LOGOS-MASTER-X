      "text": "fui procurar saber o significado.",
      "kind": "climax",
      "classification_scores": {
        "intro": 0,
        "text": 0,
        "context": 0,
        "development": 0,
        "application": 1,
        "climax": 3,
        "appeal": 0
      },
      "intensity": 31
    },
    {
      "id": 50,
      "start": 199.444,
      "end": 206.764,
      "text": "O título Lamentações vem de um verbo grego que significa, entre outras coisas, chorar em voz alta.",
