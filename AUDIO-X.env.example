# Áudio X Cloud modular
# GROQ_API_KEY e OPENAI_API_KEY podem reutilizar as chaves já existentes no LOGOS MASTER X.
DEEPGRAM_API_KEY=
AUDIO_X_GROQ_ENABLED=true
AUDIO_X_DEEPGRAM_ENABLED=true
AUDIO_X_OPENAI_ENABLED=true
AUDIO_X_GROQ_PRIORITY=1
AUDIO_X_DEEPGRAM_PRIORITY=2
AUDIO_X_OPENAI_PRIORITY=3
AUDIO_X_FALLBACK_ENABLED=true
AUDIO_X_MAX_UPLOAD_MB=100
AUDIO_X_PROVIDER_TIMEOUT_SECONDS=240
AUDIO_X_GROQ_MODEL=whisper-large-v3-turbo
AUDIO_X_DEEPGRAM_MODEL=nova-3
AUDIO_X_OPENAI_TRANSCRIBE_MODEL=whisper-1
