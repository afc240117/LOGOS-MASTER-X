OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

HUGGINGFACE_API_KEY=
HUGGINGFACE_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Rotas free-first. Você pode mudar a ordem quando quiser.
LOGOS_AI_ORDER=9router,gemini,groq,openrouter,huggingface,openai
LOGOS_AI_ORDER_ECONOMICO=9router,groq,gemini,openrouter,huggingface,openai
LOGOS_AI_ORDER_QUALIDADE=9router,gemini,openai,groq,openrouter,huggingface
LOGOS_PREFER_9ROUTER=true
LOGOS_MAX_OUTPUT_TOKENS=12000
LOGOS_SYNC_TOKEN=

# 9Router — local agora; troque a URL quando migrar para cloud 24h
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_MODEL=oc/deepseek-v4-flash-free
# Modelos testados no projeto: GLM 5.2 NVIDIA, Nemotron 3 Ultra Free,
# DeepSeek V4 Flash Free, MiMo V2.5 Free e North Mini Code Free.
# Use no campo Modelo manual o ID exato exibido pelo seu 9Router/OpenCode.
